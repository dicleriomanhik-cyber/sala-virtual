PORT=4000
JWT_SECRET=troque-este-segredo-em-producao

# Connection string do Postgres do Supabase.
# No painel do Supabase: Project Settings -> Database -> Connection string -> "URI"
# (usa a versão "Connection pooling" / porta 6543 se disponivel, funciona melhor no Render free tier)
DATABASE_URL=postgresql://postgres:[SUA-PASSWORD]@db.[SEU-PROJETO].supabase.co:5432/postgres
